	column Value_OneWeekAgo
		dataType: dateTime
		formatString: Long Time
		lineageTag: 38f00a68-e2ee-4a4e-81b2-dc2983056d62
		summarizeBy: none
		sourceColumn: Value_OneWeekAgo

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Time

	column Diff_OneWeekAgo = ```
			
			VAR TodayTime = TIME(HOUR('Zmanim'[Value]), MINUTE('Zmanim'[Value]), SECOND('Zmanim'[Value]))
			VAR OneWeekAgoTime = TIME(HOUR('Zmanim'[Value_OneWeekAgo]), MINUTE('Zmanim'[Value_OneWeekAgo]), SECOND('Zmanim'[Value_OneWeekAgo]))
			VAR SecondsDifference = DATEDIFF(OneWeekAgoTime, TodayTime, SECOND)
			VAR Sign = IF(SecondsDifference > 0, "+", IF(SecondsDifference < 0, "-", ""))
			VAR Hours = ABS(SecondsDifference) / 3600
			VAR Minutes = MOD(ABS(SecondsDifference), 3600) / 60
			VAR Seconds = MOD(ABS(SecondsDifference), 60)
			VAR HoursText = IF(Hours >= 1, FORMAT(FLOOR(Hours, 1), "0") & "h ", "")
			VAR MinutesText = IF(OR(Hours >= 1, Minutes > 0), FORMAT(FLOOR(Minutes, 1), "0") & "m ", "")
			VAR SecondsText = IF(OR(OR(Hours >= 1, Minutes > 0), Seconds > 0), FORMAT(Seconds, "0") & "s", "")
			VAR FinalText = Sign & HoursText & MinutesText & SecondsText
			RETURN
			    IF (
			        SecondsDifference = 0, "No change", FinalText
			    )
			
			```
		lineageTag: 08d5d740-9e13-42e9-8de5-3e582d791a0e
