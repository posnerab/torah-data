	column Elevation_Diff_Fmt = ```
			
			VAR Elevation_Diff_Min = 
			    DATEDIFF(
			        'Zmanim'[Value],
			        'Zmanim'[Value_Elevation],
			        MINUTE
			    )
			VAR Elevation_Diff_Rmndr = 
			    (DATEDIFF(
			        'Zmanim'[Value],
			        'Zmanim'[Value_Elevation],
			        SECOND
			    )) - (Elevation_Diff_Min * 60)
			RETURN
			    IF (
			        'Zmanim'[Elevation_Influence] = TRUE,
			        IF (
			            Elevation_Diff_Min > 0,
			            "+" & FORMAT(Elevation_Diff_Min, "0") & "m",
			            IF (
			                Elevation_Diff_Min < 0,
			                FORMAT(Elevation_Diff_Min, "0") & "m",
			                "0m"
			            )
			        ) &
			        IF (
			            Elevation_Diff_Rmndr < 0,
			            " " & FORMAT(-1*Elevation_Diff_Rmndr, "0") & "s",
			            IF (
			                Elevation_Diff_Rmndr > 0,
			                " " & FORMAT(Elevation_Diff_Rmndr, "0") & "s",
			                ""
			            )
			        ),
			        ""
			    )
			```
		lineageTag: 66685e43-7634-472d-867a-f0e1bc16cbf6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

