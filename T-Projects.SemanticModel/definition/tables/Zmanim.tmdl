	measure Hour_Length = ```
			
			VAR SunriseTime = CALCULATE(MAX('Zmanim'[Value]), 'Zmanim'[Variable] = "Sunrise")
			VAR SunsetTime = CALCULATE(MAX('Zmanim'[Value]), 'Zmanim'[Variable] = "Sunset")
			VAR TotalSeconds = DATEDIFF(SunriseTime, SunsetTime, SECOND)/12
			VAR Hours = TotalSeconds / 3600
			VAR Minutes = MOD(TotalSeconds, 3600) / 60
