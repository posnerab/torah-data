	column HebrewYear_Position = ```
			
			VAR TodayDate = TODAY()
			VAR CurrentHebrewYear =
			    CALCULATE (
			        MAX ( Hebcal[Hebrew Year] ),
			        FILTER ( ALL ( Hebcal ), Hebcal[Date] <= TodayDate )
			    )
			VAR Y = Hebcal[Hebrew Year]
			RETURN
			SWITCH (
			    TRUE(),
			        Y <= CurrentHebrewYear - 2, "Past",
			        Y =  CurrentHebrewYear - 1, "Last",
			        Y =  CurrentHebrewYear,     "Current",
			        Y =  CurrentHebrewYear + 1, "Next",
			        "Future"
			)
			
			```
		lineageTag: d0017bb2-44e1-4dff-a247-e3128990f393
		summarizeBy: none
		sortByColumn: HebrewYear_Position_Order

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column HebrewYear_Position_Order = ```
			
			VAR TodayDate = TODAY()
			VAR CurrentHebrewYear =
			    CALCULATE (
			        MAX ( Hebcal[Hebrew Year] ),
			        FILTER ( ALL ( Hebcal ), Hebcal[Date] <= TodayDate )
			    )
			VAR Y = Hebcal[Hebrew Year]
			RETURN
			SWITCH (
			    TRUE(),
			        Y <= CurrentHebrewYear - 2, 1,   // Past
			        Y =  CurrentHebrewYear - 1, 2,   // Last
			        Y =  CurrentHebrewYear,     3,   // Current
			        Y =  CurrentHebrewYear + 1, 4,   // Next
			        5                              // Future
			)
			
			```
		formatString: 0
