	column YearLengthDays = ```
			
			VAR ThisYear = 'Hebcal'[Hebrew Year]
			VAR MinDate = 
			    CALCULATE(
			        MIN('Hebcal'[HebrewDatePseudo]),
			        FILTER('Hebcal', 'Hebcal'[Hebrew Year] = ThisYear)
			    )
			VAR MaxDate = 
			    CALCULATE(
			        MAX('Hebcal'[HebrewDatePseudo]),
			        FILTER('Hebcal', 'Hebcal'[Hebrew Year] = ThisYear)
			    )
			RETURN 
			DATEDIFF(MinDate, MaxDate, DAY) + 1
			
			```
