	column EarliestMincha_Time = ```
			
			VAR EarliestMinchaTime = 'Hebcal'[minchaGedola]
			VAR Midnight = CONVERT('Hebcal'[Date], DATETIME)
			VAR TotalSeconds = DATEDIFF(Midnight, EarliestMinchaTime, SECOND)
			VAR Hours = TotalSeconds / 3600
			VAR Minutes = MOD(TotalSeconds, 3600) / 60
			VAR Seconds = MOD(TotalSeconds, 60) // Calculate remaining seconds
			VAR Hours12 = MOD(FLOOR(Hours, 1) - 1, 12) + 1 // Convert to 12-hour format
			VAR HourValue = IF(Hours12 = 0, "12", FORMAT(Hours12, "0"))
			RETURN
			IF(
			    NOT ISBLANK(Midnight) && NOT ISBLANK(EarliestMinchaTime),
			    HourValue & ":" &
			    FORMAT(FLOOR(Minutes, 1), "00") & ":" & // Use FLOOR instead of ROUND to ensure whole minutes
			    FORMAT(Seconds, "00") & " PM", // Add seconds to the output
			    BLANK()
			)
			
			```
