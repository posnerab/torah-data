	column 'Major Holiday' =
			SWITCH(
				TRUE,
				ISBLANK('Hebcal'[Major Holiday Days]),
				"(Blank)",
				'Hebcal'[Major Holiday Days] IN {"Chanukah: 1 Candle",
					"Chanukah: 2 Candles",
					"Chanukah: 3 Candles",
					"Chanukah: 4 Candles",
					"Chanukah: 5 Candles",
					"Chanukah: 6 Candles",
