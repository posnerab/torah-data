	column Candle_Time = ```
			
			VAR CandleTime = 'Hebcal'[sunset]
			VAR Midnight = CONVERT('Hebcal'[Date], DATETIME)
			VAR TotalSeconds = DATEDIFF(Midnight, CandleTime, SECOND) - (18*60)
			VAR Hours = TotalSeconds / 3600
			VAR Minutes = FLOOR(MOD(TotalSeconds, 3600) / 60, 1) // Floor the minutes to ensure rounding down
			VAR Seconds = 0 // Set seconds to 0 explicitly to always round down
			VAR Hours12 = MOD(FLOOR(Hours, 1) - 1, 12) + 1 // Convert to 12-hour format
			VAR HourValue = IF(Hours12 = 0, "12", FORMAT(Hours12, "0"))
			RETURN
			IF(
			    NOT ISBLANK(Midnight) && NOT ISBLANK(CandleTime),
			    HourValue & ":" &
			    FORMAT(Minutes, "00") & " PM",
			    BLANK()
			)
			
			```
		lineageTag: 1619b23b-b950-4d40-bbb7-54aa5cc30a20
		summarizeBy: none

