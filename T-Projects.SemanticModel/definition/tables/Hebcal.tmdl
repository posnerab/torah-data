	column 'In Current Cycle' = ```
			
			VAR CurrentDate =
			    TODAY()
			
			-- What Hebrew year are we in today?
			VAR CurrentHebrewYear =
			    CALCULATE(
			        MAX ( 'Hebcal'[Hebrew Year] ),
			        FILTER (
			            ALL ( 'Hebcal' ),
			            'Hebcal'[date] = CurrentDate
			        )
			    )
			
			-- Bereshis of the current Hebrew year
			VAR ThisYearBereshisDate =
			    CALCULATE(
			        MIN ( 'Hebcal'[date] ),
			        FILTER (
			            ALL ( 'Hebcal' ),
			            'Hebcal'[Hebrew Year] = CurrentHebrewYear
			                && 'Hebcal'[Parasha] = "Bereishis"
			        )
			    )
			
			-- Bereshis of the next Hebrew year
			VAR NextYearBereshisDate =
			    CALCULATE(
			        MIN ( 'Hebcal'[date] ),
			        FILTER (
			            ALL ( 'Hebcal' ),
			            'Hebcal'[Hebrew Year] = CurrentHebrewYear + 1
			                && 'Hebcal'[Parasha] = "Bereishis"
			        )
			    )
			
			RETURN
			IF (
			    NOT ISBLANK ( ThisYearBereshisDate )
			        && NOT ISBLANK ( NextYearBereshisDate )
			        && 'Hebcal'[date] >= ThisYearBereshisDate
			        && 'Hebcal'[date] < NextYearBereshisDate,
			    TRUE (),
			    FALSE ()
			)
			
			```
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: e6efa7cd-c708-40f0-9af9-05375a46ff9b
		summarizeBy: none

