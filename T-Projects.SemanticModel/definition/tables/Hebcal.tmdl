	column 'Erev Rosh Chodesh' = ```
			
			VAR CurrentDate = Hebcal[Date]
			
			VAR NextDate =
			    CALCULATE(
			        MIN(Hebcal[Date]),
			        FILTER(ALL(Hebcal), Hebcal[Date] > CurrentDate)
			    )
			
			VAR CurrentHebrewDay =
			    Hebcal[Hebrew Day of Month]
			
			VAR NextHebrewDay =
			    CALCULATE(
			        MAX(Hebcal[Hebrew Day of Month]),
			        FILTER(ALL(Hebcal), Hebcal[Date] = NextDate)
			    )
			
			VAR NextRoshChodeshMonth =
			    CALCULATE(
			        MAX(Hebcal[Rosh Chodesh]),
			        FILTER(ALL(Hebcal), Hebcal[Date] = NextDate)
			    )
			
			VAR IsTomorrowRoshChodesh = NOT(ISBLANK(NextRoshChodeshMonth))
			
			RETURN
			IF(
			    IsTomorrowRoshChodesh &&
			    (
			        (NextHebrewDay = 1 && CurrentHebrewDay <> 30) ||  // one-day Rosh Chodesh
			        (NextHebrewDay = 30 && CurrentHebrewDay = 29)     // two-day Rosh Chodesh
			    ),
			    NextRoshChodeshMonth,
			    BLANK()
			)
			
			```
		lineageTag: 0aa5dbbc-ca77-4158-b5fa-b7cd67a0ec2b
		summarizeBy: none

