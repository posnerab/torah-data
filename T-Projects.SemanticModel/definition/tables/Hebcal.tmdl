	column 'Parasha Display' = IF(Hebcal[Parasha]="",Hebcal[Major Holiday],Hebcal[Parasha])
		lineageTag: 9b3deaad-0be5-4332-8f96-14c3ef199bd6
		summarizeBy: none
		sortByColumn: Index_Parasha

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

		annotation __PBI_SemanticLinks = [{"LinkTarget":{"TableName":"Hebcal","TableItemName":"Parasha Display (groups)","ObjectType":4},"LinkType":"UsedInGroup"}]

	column 'Sifrei Torah Main Reading' = ```
			
			VAR TorahReadingBlank =
			    ISBLANK ( 'Hebcal'[Torah Reading Display] ) || 'Hebcal'[Torah Reading Display] = ""
			VAR RoshChodeshNotBlank =
			    NOT ( ISBLANK ( 'Hebcal'[Rosh Chodesh] ) || 'Hebcal'[Rosh Chodesh] = "" )
			VAR SpecialShabbosBlank =
			    ISBLANK ( 'Hebcal'[Special Shabbos] ) || 'Hebcal'[Special Shabbos] = ""
			VAR SpecialShabbosNotBlank =
			    NOT SpecialShabbosBlank
			VAR MajorHoliday =
			    'Hebcal'[Holiday Display]
			VAR MajorHolidayGroup =
			    Hebcal[Major Holiday]
			VAR HolidayPart =
			    'Hebcal'[Holiday Part]
			VAR DayName =
			    'Hebcal'[Day Name]
			VAR IsErev =
			    LEFT ( MajorHoliday, 5 ) = "Erev "
			RETURN
			SWITCH (
			    TRUE (),
			
			    -- No Torah reading
			    TorahReadingBlank, 0,
			
			    -- 3 scrolls: Rosh Chodesh + Shabbos + Special Shabbos OR Chanukah
			    RoshChodeshNotBlank && DayName = "Saturday" &&
			        ( SpecialShabbosNotBlank || MajorHolidayGroup = "Chanukah" ), 3,
			
			    -- Major Holidays always 2 scrolls (not Erev)
			    NOT IsErev && MajorHolidayGroup IN { "Rosh Hashanah", "Yom Kippur", "Shavuos" }, 2,
			
			    -- Pesach or Succos (Yom Tov) - not Erev
			    (NOT IsErev && MajorHolidayGroup IN { "Pesach", "Succos" } && HolidayPart = "Yom Tov"), 2,
			
			    -- Pesach or Succos on Saturday - not Erev
			    (NOT IsErev && MajorHoliday IN { "Pesach", "Succos" } && DayName = "Saturday"), 2,
			
			    -- Chanukah special case (not Erev)
			    (NOT IsErev && MajorHolidayGroup = "Chanukah" && DayName = "Saturday"), 2,
			    (NOT IsErev && MajorHolidayGroup = "Chanukah" && DayName <> "Saturday"), 1,
			
			    -- Chol Hamoed cases
			    (HolidayPart = "Chol Hamoed" && DayName = "Saturday"), 2,
			    (HolidayPart = "Chol Hamoed" && DayName <> "Saturday"), 1,
			
			    -- Rosh Chodesh not Saturday
			    RoshChodeshNotBlank && DayName <> "Saturday", 1,
			
			    -- Rosh Chodesh on Saturday without Special Shabbos
			    RoshChodeshNotBlank && DayName = "Saturday" && SpecialShabbosBlank, 2,
			
			    -- Otherwise: Torah reading present = at least 1
			    NOT TorahReadingBlank, 1,
			
			    -- Default
			    BLANK ()
			)
			
			```
		formatString: 0
		lineageTag: 9c15105d-5773-448e-9ad7-fb8a642879cc
		summarizeBy: sum

