	column 'Sifrei Torah Total' = ```
			
			VAR MainReading =
			    'Hebcal'[Sifrei Torah Main Reading]
			VAR DayName =
			    'Hebcal'[Day Name]
			VAR MajorHoliday =
			    'Hebcal'[Major Holiday]
			VAR FastDayNotBlank =
			    NOT ( ISBLANK ( 'Hebcal'[Fast] ) || 'Hebcal'[Fast] = "" )
			
			VAR AddShabbosMincha =
			    IF ( DayName = "Saturday", 1, 0 )
			
			VAR AddFastDay =
			    IF ( FastDayNotBlank, 1, 0 )
			
			VAR AddYomKippurMincha =
			    IF ( MajorHoliday = "Yom Kippur" && DayName <> "Saturday", 1, 0 )
			
			RETURN
			MainReading + AddShabbosMincha + AddFastDay + AddYomKippurMincha
			
			```
