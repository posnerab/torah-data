table Hebcal
	lineageTag: bce62060-fb0a-4e69-bb06-4ac307934a8f

	measure 'Hebrew Year Type' = ```
			
			VAR DaysInYear = DISTINCTCOUNT('Hebcal'[Hebrew Date])
			VAR Year = SELECTEDVALUE('Hebcal'[Hebrew Year])
			VAR IsLeap =
			    IF(MOD(Year * 7 + 1, 19) < 7, TRUE, FALSE)
			
			RETURN
			    SWITCH(
			        TRUE(),
			        IsLeap && DaysInYear = 383, "Leap Year - Chaser",
			        IsLeap && DaysInYear = 384, "Leap Year - Kesidrah",
			        IsLeap && DaysInYear = 385, "Leap Year - Maleh",
			        NOT IsLeap && DaysInYear = 353, "Common Year - Chaser",
			        NOT IsLeap && DaysInYear = 354, "Common Year - Kesidrah",
			        NOT IsLeap && DaysInYear = 355, "Common Year - Maleh",
			        "Unknown"
			    )
			
			```
		lineageTag: 68cc9a3a-b630-4774-b55c-562aed338c50

	measure 'Machzor Number Minor' = ```
			
			VAR Year = SELECTEDVALUE('Hebcal'[Hebrew Year])
			RETURN 
			INT( (Year - 1) / 19 ) + 1
			
			```
		formatString: 0
		lineageTag: d66470d8-aa87-4f70-b26e-7e0481220ecd

	measure 'Machzor Year' = ```
			
			VAR Year = SELECTEDVALUE('Hebcal'[Hebrew Year])
			RETURN 
			MOD(Year - 1, 19) + 1
			
			```
		formatString: 0
		lineageTag: 2b1e876e-e4fc-44d0-9c78-7a173a71a0c7

	measure 'Average Annual Sifrei Torah' = ```
			
			VAR YearlyTotals =
			    SUMMARIZE (
			        'Hebcal',
			        'Hebcal'[Hebrew Year],                 -- group by year
			        "YearTotal", SUM ( 'Hebcal'[Sifrei Torah Total] )  -- sum total per year
			    )
			RETURN
			AVERAGEX ( YearlyTotals, [YearTotal] )
			
			```
		formatString: 0.00
		lineageTag: cdf43d40-0661-48ff-bf48-a26bdf759b55

	measure 'Is Current Year' = ```
			
			IF (
			    YEAR ( MAX ( 'Hebcal'[Date] ) ) = YEAR ( TODAY () ),
			    "Yes",
			    "No"
			)
			
			```
		lineageTag: 198e504d-b9a8-4ba0-8c41-6b093076a70c

	measure 'Average Annual Day Count' = ```
			
			VAR YearlyTotals =
			    SUMMARIZE (
			        'Hebcal',
			        'Hebcal'[Hebrew Year],                      -- group by Hebrew Year
			        "YearTotal",
			            COUNTROWS ( DISTINCT ( 'Hebcal'[Hebrew Date] ) )  -- count Hebrew days
			    )
			RETURN
			AVERAGEX ( YearlyTotals, [YearTotal] )
			
			```
		lineageTag: e6899b69-b851-4b7b-9615-6d01f82bc77b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure MajorHoliday_DayName_List = ```
			
			VAR SelectedYear =
			    SELECTEDVALUE ( Hebcal[Hebrew Year] )
			
			VAR Holidays =
			    SUMMARIZE (
			        CALCULATETABLE (
			            FILTER (
			                ALLSELECTED ( Hebcal ),
			                NOT ISBLANK ( Hebcal[Major Holiday] )
			            ),
			            TREATAS ( { SelectedYear }, Hebcal[Hebrew Year] )
			        ),
			        Hebcal[Major Holiday],
			        "HolidayOrder", MIN ( Hebcal[Date] )
			    )
			
			RETURN
			CONCATENATEX (
			    ADDCOLUMNS (
			        Holidays,
			        "Items",
			            VAR ThisHoliday = [Major Holiday]
			            VAR DaysForHoliday =
			                CALCULATETABLE (
			                    SUMMARIZE (
			                        FILTER (
			                            ALLSELECTED ( Hebcal ),
			                            Hebcal[Major Holiday] = ThisHoliday
			                                && NOT ISBLANK ( Hebcal[Major Holiday] )
			                                && NOT ( Hebcal[Major Holiday] = "")
			                        ),
			                        Hebcal[Major Holiday Days],
			                        Hebcal[Day Name],
			                        "SortOrder", MIN ( Hebcal[Date] )
			                    ),
			                    TREATAS ( { SelectedYear }, Hebcal[Hebrew Year] )
			                )
			            RETURN
			                CONCATENATEX (
			                    DaysForHoliday,
			                    Hebcal[Major Holiday Days] & ": " & Hebcal[Day Name],
			                    ", ",
			                    [SortOrder], ASC
			                )
			    ),
			    [Items],
			    "; ",
			    [HolidayOrder], ASC
			)
			
			```
		lineageTag: ab35c018-a8f6-4fc1-acde-b21b9fe0e6aa

	measure 'Is Current Hebrew Year' = ```
			
			IF (
			    MAX ( 'Hebcal'[Hebrew Year] ) = 
			        LOOKUPVALUE (
			            'Hebcal'[Hebrew Year],
			            'Hebcal'[Date], TODAY()
			        ),
			    "Yes",
			    "No"
			)
			
			```
		lineageTag: 22e32b83-a34d-4253-b28a-ec75a67b3a93

	measure 'Hebrew Year Full Type' = ```
			
			VAR DaysInYear = DISTINCTCOUNT('Hebcal'[Hebrew Date])
			VAR Year = SELECTEDVALUE('Hebcal'[Hebrew Year])
			VAR IsLeap =
			    IF(MOD(Year * 7 + 1, 19) < 7, TRUE, FALSE)
			
			RETURN
			    SWITCH(
			        TRUE(),
			        IsLeap && DaysInYear = 383, "Chaser",
			        IsLeap && DaysInYear = 384, "Kesidrah",
			        IsLeap && DaysInYear = 385, "Maleh",
			        NOT IsLeap && DaysInYear = 353, "Chaser",
			        NOT IsLeap && DaysInYear = 354, "Kesidrah",
			        NOT IsLeap && DaysInYear = 355, "Maleh",
			        "Unknown"
			    )
			
			```
		lineageTag: f71d4b52-34cc-44e3-94ca-f49769e40f5a

	measure 'Hebrew Year Type (Combined)' = ```
			
			VAR DaysInYear = DISTINCTCOUNT ( 'Hebcal'[Hebrew Date] )
			RETURN
			    SWITCH (
			        TRUE (),
			        DaysInYear IN { 383, 353 }, "Chaser (Deficient)",
			        DaysInYear IN { 384, 354 }, "Kesidrah (Regular)",
			        DaysInYear IN { 385, 355 }, "Maleh (Full)",
			        "Unknown"
			    )
			
			```
		lineageTag: 6fa6aca7-4843-4a8a-8d71-c34ca70f1e71

	measure 'Days in Cheshvan' = ```
			
			VAR _Year = SELECTEDVALUE ( 'Hebcal'[Hebrew Year] )
			RETURN
			CALCULATE (
			    MAX ( 'Hebcal'[Days in Hebrew Month] ),
			    KEEPFILTERS ( 'Hebcal'[Hebrew Month] = "Cheshvan" ),
			    KEEPFILTERS ( 'Hebcal'[Hebrew Year] = _Year )
			)
			
			```
		formatString: 0
		lineageTag: 42972f4e-2a86-40aa-887c-c055bae54bc8

	measure 'Days in Kislev' = ```
			
			VAR _Year = SELECTEDVALUE ( 'Hebcal'[Hebrew Year] )
			RETURN
			CALCULATE (
			    MAX ( 'Hebcal'[Days in Hebrew Month] ),
			    KEEPFILTERS ( 'Hebcal'[Hebrew Month] = "Kislev" ),
			    KEEPFILTERS ( 'Hebcal'[Hebrew Year] = _Year )
			)
			
			```
		formatString: 0
		lineageTag: 2e45052b-c0f0-4f99-b3ef-5e4eb2b53563

