	measure HolidayPatternTable = ```
			
			VAR Years =
			    SUMMARIZE ( Hebcal, Hebcal[Hebrew Year] )
			
			RETURN
			SUMMARIZE (
			    ADDCOLUMNS (
			        Years,
			        "Pattern",
			            VAR ThisYear = [Hebrew Year]
			            VAR Days =
			                SUMMARIZE (
			                    CALCULATETABLE (
			                        FILTER (
			                            ALL ( Hebcal ),
			                            NOT ISBLANK ( Hebcal[Major Holiday] )
			                                && NOT ISBLANK ( Hebcal[Major Holiday Days] )
			                        ),
			                        TREATAS ( { ThisYear }, Hebcal[Hebrew Year] )
			                    ),
			                    Hebcal[Major Holiday],
			                    Hebcal[Major Holiday Days],
			                    Hebcal[Day Name],
			                    "SortOrder", MIN ( Hebcal[Date] )
			                )
			            RETURN
			                CONCATENATEX (
			                    Days,
			                    Hebcal[Major Holiday] & ": "
			                        & Hebcal[Major Holiday Days] & " → "
			                        & Hebcal[Day Name],
			                    "; ",
			                    [SortOrder],
			                    ASC
			                )
			    ),
			    [Pattern]
			)
			
			```
		lineageTag: 1b789afb-96cd-4636-b7df-a53ce6d4ed7b

