	column Day_Length = ```
			
			VAR SunriseTime = 'Hebcal'[sunrise]
			VAR SunsetTime = 'Hebcal'[sunset]
			VAR TotalSeconds = DATEDIFF(SunriseTime, SunsetTime, SECOND)
			VAR Hours = TotalSeconds / 3600
			VAR Minutes = MOD(TotalSeconds, 3600) / 60
			VAR Seconds = MOD(TotalSeconds, 60) // Calculate remaining seconds
			RETURN
			IF(
			    NOT ISBLANK(SunriseTime) && NOT ISBLANK(SunsetTime),
			    FORMAT(FLOOR(Hours, 1), "0") & "h " &
			    FORMAT(FLOOR(Minutes, 1), "0") & "m " & // Use FLOOR instead of ROUND to ensure whole minutes
			    FORMAT(Seconds, "0") & "s", // Add seconds to the output
			    BLANK()
			)
			
			```
		lineageTag: db170ffe-6084-443e-9a7a-dcb82ea940de
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Day_Length_Sec =
			
			VAR SunriseTime = 'Hebcal'[sunrise]
			VAR SunsetTime = 'Hebcal'[sunset]
			VAR TotalSeconds = DATEDIFF(SunriseTime, SunsetTime, SECOND)
