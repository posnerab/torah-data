	column 'Unique Holiday' = ```
			
			VAR Holiday = TRIM('Hebcal'[Jewish Holidays])
			VAR HebrewYear = 'Hebcal'[Hebrew Year]
			VAR Index = 'Hebcal'[Index]
			VAR HolidayLabel = 'Hebcal'[Jewish Holidays-Year]
			VAR HolidayRankValue = 'Hebcal'[HolidayRank]
			
			RETURN
			IF(
			    ISBLANK(Holiday) || Holiday = "",
			    "N/A (" & Index & ") " & HebrewYear,
			    IF(
			        HolidayRankValue > 1,
			        HolidayLabel & " (Day " & HolidayRankValue & ")",
			        HolidayLabel
			    )
			)
			
			```
		lineageTag: 5452f978-ffe0-4c1b-985c-643856d6971a
		summarizeBy: none
		sortByColumn: Index

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Jewish Holidays-Year' = ```
			
			VAR Holiday = TRIM('Hebcal'[Jewish Holidays])
			VAR HebrewYear = 'Hebcal'[Hebrew Year]
			
			RETURN
			IF(
			    ISBLANK(Holiday) || Holiday = "",
			    BLANK(),
			    VAR ExtractedYear =
			        CALCULATE(
			            MAXX(
			                FILTER(
			                    GENERATESERIES(5700, 5900, 1),
			                    SEARCH(FORMAT([Value], "0000"), Holiday, 1, 0) > 0
			                ),
			                [Value]
			            )
			        )
			    VAR HolidayWithoutYear =
			        TRIM(
			            SUBSTITUTE(
			                SUBSTITUTE(
			                    SUBSTITUTE(Holiday, FORMAT(ExtractedYear, "0000"), ""),
			                    FORMAT(HebrewYear, "0000"),
			                    ""
			                ),
			                "()", ""
			            )
			        )
			    RETURN
			        IF(
			            ISBLANK(ExtractedYear),
			            Holiday & " " & HebrewYear,
			            IF(
			                HolidayWithoutYear = "",
			                "Unnamed Holiday " & ExtractedYear,
			                Holiday
			            )
			        )
			)
			
			```
		lineageTag: f0f272d7-9760-42f8-aeed-41a6f22a49b5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column HolidayRank = ```
			
			VAR HolidayLabel = 'Hebcal'[Jewish Holidays-Year]
			
			RETURN
			IF(
			    ISBLANK(HolidayLabel) || HolidayLabel = "",
			    BLANK(),
			    RANKX(
			        FILTER(
			            'Hebcal',
			            NOT(ISBLANK('Hebcal'[Jewish Holidays-Year])) &&
			            'Hebcal'[Jewish Holidays-Year] <> "" &&
			            'Hebcal'[Jewish Holidays-Year] = HolidayLabel
			        ),
			        'Hebcal'[Date],
			        ,
			        ASC,
			        DENSE
			    )
			)
			
			```
		formatString: 0
		lineageTag: 39c7b9cd-51bd-44ac-8bd2-f8f5f4d8721a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Type = ```
			
			VAR CurrentDate = TODAY()
			
			// Next Holiday (exclude N/A and Rosh Chodesh)
			VAR NextHolidayDate =
			    MINX(
			        FILTER(
			            'Hebcal',
			            'Hebcal'[date] >= CurrentDate &&
			            NOT ( ISBLANK ( 'Hebcal'[Major Holiday] ) ) &&
			            'Hebcal'[Major Holiday] <> "" &&
			            LEFT ( 'Hebcal'[Unique Holiday], 3 ) <> "N/A" &&
			            LEFT ( 'Hebcal'[Unique Holiday], 12 ) <> "Rosh Chodesh"
			        ),
			        'Hebcal'[date]
			    )
			
			// Next Shabbos (Saturday)
			VAR NextShabbosDate =
			    MINX(
			        FILTER(
			            'Hebcal',
			            'Hebcal'[date] >= CurrentDate &&
			            'Hebcal'[Day Name] = "Saturday"
			        ),
			        'Hebcal'[date]
			    )
			
			// Next Rosh Chodesh
			VAR NextRoshChodeshDate =
			    MINX(
			        FILTER(
			            'Hebcal',
			            'Hebcal'[date] >= CurrentDate &&
			            CONTAINSSTRING ( 'Hebcal'[Unique Holiday], "Rosh Chodesh" )
			        ),
			        'Hebcal'[date]
			    )
			
			// Next Yom Tov / Festival
			VAR NextFestivalDate =
			    MINX(
			        FILTER(
			            'Hebcal',
			            'Hebcal'[date] >= CurrentDate &&
			            (
			                CONTAINSSTRING ( 'Hebcal'[Unique Holiday], "Pesach" ) ||
			                CONTAINSSTRING ( 'Hebcal'[Unique Holiday], "Shavuos" ) ||
			                CONTAINSSTRING ( 'Hebcal'[Unique Holiday], "Succos" ) ||
			                (
			                    CONTAINSSTRING ( 'Hebcal'[Unique Holiday], "Rosh Hashana" ) &&
			                    NOT CONTAINSSTRING ( 'Hebcal'[Unique Holiday], "LaBehemot" )
			                ) ||
			                CONTAINSSTRING ( 'Hebcal'[Unique Holiday], "Yom Kippur" )
			            )
			        ),
			        'Hebcal'[date]
			    )
			
			// Base next mitzvah *date* (first upcoming date whose Parasha has at least one non-blank Mitzvah)
			VAR NextMitzvahBaseDate =
			    MINX(
			        FILTER(
			            ADDCOLUMNS(
			                'Hebcal',
			                "__HasMitzvah",
			                    VAR RelatedMitzvos =
			                        FILTER(
			                            RELATEDTABLE ( 'Parasha-Mitzvos' ),
			                            NOT ISBLANK ( 'Parasha-Mitzvos'[Mitzvah] )
			                        )
			                    RETURN
			                        IF ( NOT ISEMPTY ( RelatedMitzvos ), 1, 0 )
			            ),
			            'Hebcal'[date] >= CurrentDate &&
			            [__HasMitzvah] = 1
			        ),
			        'Hebcal'[date]
			    )
			
			// Shabbos Date corresponding to that base mitzvah date
			VAR NextMitzvahShabbosDate =
			    IF (
			        ISBLANK ( NextMitzvahBaseDate ),
			        BLANK (),
			        CALCULATE(
			            MIN ( 'Hebcal'[Shabbos Date] ),
			            ALL ( 'Hebcal' ),
			            'Hebcal'[date] = NextMitzvahBaseDate
			        )
			    )
			
			// Relative position
			VAR RelativeType =
			    SWITCH (
			        TRUE (),
			        'Hebcal'[date] = CurrentDate,       "Today",
			        'Hebcal'[date] = CurrentDate - 1,   "Yesterday",
			        'Hebcal'[date] = CurrentDate + 1,   "Tomorrow",
			        "Other"
			    )
			
			// Final result
			RETURN
			SWITCH (
			    TRUE (),
			    'Hebcal'[date] = NextMitzvahShabbosDate, "Next Mitzvah",
			    'Hebcal'[date] = NextHolidayDate,        "Next Holiday",
			    'Hebcal'[date] = NextShabbosDate,        "Next Shabbos",
			    'Hebcal'[date] = NextRoshChodeshDate,    "Next Rosh Chodesh",
			    'Hebcal'[date] = NextFestivalDate,       "Next Festival",
			    TRUE (),                                 RelativeType
			)
			
			```
		lineageTag: ca2274b8-3268-452d-b940-75ee220f9373
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Unique Holiday Text' = ```
			
			VAR HolidayText = 'Hebcal'[Unique Holiday]
			RETURN
			IF(
			    ISBLANK(HolidayText) || HolidayText = "" || LEFT(HolidayText, 3) = "N/A",
			    BLANK(),
			    HolidayText
			)
			
