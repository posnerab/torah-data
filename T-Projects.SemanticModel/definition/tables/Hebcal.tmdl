	column Shema_Time_Gra = ```
			
			VAR ShemaTime = 'Hebcal'[sofZmanShma]
			VAR Midnight = CONVERT('Hebcal'[Date], DATETIME)
			VAR TotalSeconds = DATEDIFF(Midnight, ShemaTime, SECOND)
			VAR Hours = TotalSeconds / 3600
			VAR Minutes = MOD(TotalSeconds, 3600) / 60
			VAR Seconds = MOD(TotalSeconds, 60) // Calculate remaining seconds
			RETURN
			IF(
			    NOT ISBLANK(Midnight) && NOT ISBLANK(ShemaTime),
			    FORMAT(FLOOR(Hours, 1), "0") & ":" &
			    FORMAT(FLOOR(Minutes, 1), "00") & ":" & // Use FLOOR instead of ROUND to ensure whole minutes
			    FORMAT(Seconds, "00") & " AM", // Add seconds to the output
			    BLANK()
			)
			
			```
