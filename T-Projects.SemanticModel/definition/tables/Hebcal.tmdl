	column 'Hebrew Year Type Col' = ```
			
			VAR ThisYear = 'Hebcal'[Hebrew Year]
			VAR DaysInYear = 
			    CALCULATE(
			        DISTINCTCOUNT('Hebcal'[Hebrew Date]),
			        FILTER('Hebcal', 'Hebcal'[Hebrew Year] = ThisYear)
			    )
			VAR IsLeap = 
			    IF(MOD(ThisYear * 7 + 1, 19) < 7, TRUE, FALSE)
			
			RETURN
			    SWITCH(
			        TRUE(),
			        IsLeap && DaysInYear = 383, "Leap Year - Chaser",
			        IsLeap && DaysInYear = 384, "Leap Year - Kesidrah",
			        IsLeap && DaysInYear = 385, "Leap Year - Maleh",
			        NOT IsLeap && DaysInYear = 353, "Common Year - Chaser",
			        NOT IsLeap && DaysInYear = 354, "Common Year - Kesidrah",
			        NOT IsLeap && DaysInYear = 355, "Common Year - Maleh",
			        "Unknown"
			    )
			
			```
		lineageTag: 14730b2d-efe8-4146-9c52-a036c4be5ff4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column HebrewDatePseudo = DATE('Hebcal'[Hebrew Year], 'Hebcal'[HebrewMonthNumber], 'Hebcal'[Hebrew Day of Month])
		lineageTag: 82d62a63-aff2-4345-ba71-998fcb47ab2a
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 740ef83a-d8d7-4676-b973-367b81c5ab24
			defaultHierarchy: LocalDateTable_71f78e24-30f1-4e58-b7f6-ed2e35ef7a0c.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column HebrewMonthNumber = ```
			
			VAR m = 'Hebcal'[Hebrew Month]  -- assuming text like "Adar II"
			VAR leap = 'Hebcal'[IsLeapYear]
			RETURN
			    SWITCH(TRUE(),
			        m = "Tishrei",      1,
			        m = "Cheshvan",     2,
			        m = "Kislev",       3,
			        m = "Teves",        4,
			        m = "Shevat",       5,
			        m = "Adar" && NOT leap,   6,
			        m = "Adar I",       6,
			        m = "Adar II",      7,
			        m = "Nisan",        IF(leap, 8, 7),
			        m = "Iyar",         IF(leap, 9, 8),
			        m = "Sivan",        IF(leap, 10, 9),
			        m = "Tammuz",       IF(leap, 11, 10),
			        m = "Av",           IF(leap, 12, 11),
			        m = "Elul",         IF(leap, 13, 12),
			        BLANK()
			    )
			
			```
		lineageTag: 70f61388-4331-4814-a9ac-fa1ab1988cbe
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column HebrewYearType = ```
			
			VAR Days = 'Hebcal'[YearLengthDays]
			VAR Leap = 'Hebcal'[IsLeapYear]
			RETURN
			    SWITCH(
			        TRUE(),
			        Leap && Days = 383, "Leap Year - Chaser",
			        Leap && Days = 384, "Leap Year - Kesidrah",
			        Leap && Days = 385, "Leap Year - Maleh",
			        NOT Leap && Days = 353, "Common Year - Chaser",
			        NOT Leap && Days = 354, "Common Year - Kesidrah",
			        NOT Leap && Days = 355, "Common Year - Maleh",
			        "Unknown"
			    )
			
			```
		lineageTag: 171ba9fc-237e-4d6b-8156-58ae8ba57919
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

