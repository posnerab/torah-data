/// Gets Milwaukee zmanim for exactly seven days before the date returned by the authoritative current response.
expression 'Zmanim Last Week Unpivoted' =
		let
		    ApiDate = List.First(#"Zmanim Today Unpivoted"[ApiDate]),
		    TargetDate = Date.AddDays(ApiDate, -7),
		    Source = Json.Document(
		        Web.Contents(
		            "https://www.hebcal.com",
		            [
		                RelativePath = "zmanim",
		                Query = [
		                    cfg = "json",
		                    zip = "53216",
		                    sec = "1",
		                    date = Date.ToText(TargetDate, [Format = "yyyy-MM-dd", Culture = "en-US"])
		                ]
		            ]
		        )
		    ),
		    Times = Record.ToTable(Source[times]),
		    Renamed = Table.RenameColumns(Times, {{"Name", "Attribute"}, {"Value", "Value_OneWeekAgo"}}),
		    Filtered = Table.SelectRows(Renamed, each List.Contains(#"Zmanim Definitions"[Variable], [Attribute])),
		    Typed = Table.TransformColumnTypes(Filtered, {{"Attribute", type text}, {"Value_OneWeekAgo", type datetimezone}})
		in
		    Typed
	lineageTag: 95a36789-0487-4dd2-9abe-cf5a3a74c7a9
	queryGroup: Zmanim

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

/// Gets Milwaukee zmanim for exactly one day before the date returned by the authoritative current response.
expression 'Zmanim Yesterday Unpivoted' =
		let
		    ApiDate = List.First(#"Zmanim Today Unpivoted"[ApiDate]),
		    TargetDate = Date.AddDays(ApiDate, -1),
		    Source = Json.Document(
		        Web.Contents(
		            "https://www.hebcal.com",
		            [
		                RelativePath = "zmanim",
		                Query = [
		                    cfg = "json",
		                    zip = "53216",
		                    sec = "1",
		                    date = Date.ToText(TargetDate, [Format = "yyyy-MM-dd", Culture = "en-US"])
		                ]
		            ]
		        )
		    ),
		    Times = Record.ToTable(Source[times]),
		    Renamed = Table.RenameColumns(Times, {{"Name", "Attribute"}, {"Value", "Value_Yesterday"}}),
		    Filtered = Table.SelectRows(Renamed, each List.Contains(#"Zmanim Definitions"[Variable], [Attribute])),
		    Typed = Table.TransformColumnTypes(Filtered, {{"Attribute", type text}, {"Value_Yesterday", type datetimezone}})
		in
		    Typed
	lineageTag: d51ef750-dbe4-45cd-b01e-9ad9a5c3bf63
	queryGroup: Zmanim

