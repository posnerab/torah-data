expression 'leyning?cfg=json&start=2025-07-28&end=2025-08-03&triennial=off' =
		let
		    StartYear = 2025,
		    EndYear = 2025,

		    // Generate list of years
		    Years = List.Numbers(StartYear, EndYear - StartYear + 1),

		    // Function to get data for a single year
		    GetHebcalData = (Year as number) =>
		        let
		            StartDate = Text.From(Year) & "-01-01",
		            EndDate   = Text.From(Year) & "-12-31",
		            URL = "https://www.hebcal.com/leyning?cfg=json"
		                & "&start=" & StartDate
		                & "&end=" & EndDate
		                & "&triennial=off"
		                & "&lang=a",
		            JsonResponse = Json.Document(
		                Web.Contents(
		                    URL,
		                    [
		                        Headers = [#"Accept-Encoding"="gzip, deflate"]
		                    ]
		                )
		            ),
		            TableResponse = Table.FromRecords({JsonResponse})
		        in
		            TableResponse,

		    // Combine data for all years
		    AllYearsRaw = List.Transform(Years, each GetHebcalData(_)),
		    Combined = Table.Combine(AllYearsRaw),
		    #"Converted to Table" = Combined,
		    #"Expanded range" = Table.ExpandRecordColumn(#"Converted to Table", "range", {"start", "end"}, {"range.start", "range.end"}),
		    #"Expanded items" = Table.ExpandListColumn(#"Expanded range", "items"),
		    #"Expanded items1" = Table.ExpandRecordColumn(#"Expanded items", "items", {"date", "hdate", "name", "type", "fullkriyah", "summary", "summaryParts", "weekday", "megillah", "haftara", "haft"}, {"items.date", "items.hdate", "items.name", "items.type", "items.fullkriyah", "items.summary", "items.summaryParts", "items.weekday", "items.megillah", "items.haftara", "items.haft"}),
		    #"Expanded items.name" = Table.ExpandRecordColumn(#"Expanded items1", "items.name", {"en", "he"}, {"items.name.en", "items.name.he"})
		in
		    #"Expanded items.name"
	lineageTag: b8d23929-dc0a-4062-9b30-93dc6f37a9bb

