/// Gets the location-authoritative current Milwaukee date from Hebcal and returns only variables in the static definition contract.
expression 'Zmanim Today Unpivoted' =
		let
		    Source = Json.Document(
		        Web.Contents(
		            "https://www.hebcal.com",
		            [
		                RelativePath = "zmanim",
		                Query = [cfg = "json", zip = "53216", sec = "1"]
		            ]
		        )
		    ),
		    ApiDate = Date.FromText(Source[date]),
		    Times = Record.ToTable(Source[times]),
		    Renamed = Table.RenameColumns(Times, {{"Name", "Attribute"}, {"Value", "Value"}}),
		    Filtered = Table.SelectRows(Renamed, each List.Contains(#"Zmanim Definitions"[Variable], [Attribute])),
		    WithDate = Table.AddColumn(Filtered, "ApiDate", each ApiDate, type date),
		    Typed = Table.TransformColumnTypes(WithDate, {{"Attribute", type text}, {"Value", type datetimezone}})
		in
		    Typed
	lineageTag: 7307c1dc-a09e-429d-9c40-c761fb7a32fe
	queryGroup: Zmanim

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

/// Gets elevation-adjusted Milwaukee zmanim for the exact date returned by the authoritative current response.
expression 'Zmanim Today Unpivoted Elevation' =
		let
		    ApiDate = List.First(#"Zmanim Today Unpivoted"[ApiDate]),
		    Source = Json.Document(
		        Web.Contents(
		            "https://www.hebcal.com",
		            [
		                RelativePath = "zmanim",
		                Query = [
		                    cfg = "json",
		                    zip = "53216",
		                    sec = "1",
		                    ue = "on",
		                    date = Date.ToText(ApiDate, [Format = "yyyy-MM-dd", Culture = "en-US"])
		                ]
		            ]
		        )
		    ),
		    Times = Record.ToTable(Source[times]),
		    Renamed = Table.RenameColumns(Times, {{"Name", "Attribute"}, {"Value", "Value_Elevation"}}),
		    Filtered = Table.SelectRows(Renamed, each List.Contains(#"Zmanim Definitions"[Variable], [Attribute])),
		    Typed = Table.TransformColumnTypes(Filtered, {{"Attribute", type text}, {"Value_Elevation", type datetimezone}})
		in
		    Typed
	lineageTag: 881ce347-03bc-47bc-a10a-6e92063660ae
	queryGroup: Zmanim

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

/// Static 25-row semantic definition table. Edit this inline contract directly; it has no external refresh source.
expression 'Zmanim Definitions' =
		let
		    Source = #table(
		        type table [Variable = text, Definition = text, Name = text, Description = text],
		        {
		            {"alotHaShachar", "Dawn", "Alos HaShachar", "Sun is 16.1° below the horizon in the morning"},
		            {"beinHaShmashos", "Twilight", "Bein HaShmashos", "13.5 minutes prior to tzeis (nightfall) when the sun is 7.083° below horizon"},
		            {"chatzot", "Midday", "Chatzos Hayom", "Sunrise plus 6 halachic hours"},
		            {"chatzotNight", "Midnight", "Chatzos HaLailah", "Sunset plus 6 halachic hours"},
		            {"dawn", "Civil dawn", "Civil dawn", "Sun is 6° below the horizon in the morning"},
		            {"dayLength", "Day Length", "Halachic Day", "Length of the day from sunrise to sunset, according to the Gra"},
		            {"dusk", "Civil dusk", "Civil dusk", "Sun is 6° below the horizon in the evening"},
		            {"minchaGedola", "Earliest Mincha", "Mincha Gedolah", "Sunrise plus 6.5 halachic hours"},
		            {"minchaKetana", "Ideal earliest time to recite Mincha", "Mincha Ketana", "Sunrise plus 9.5 halachic hours"},
		            {"misheyakir", "Earliest tallis & tefillin", "Misheyakir", "Sun is 11.5° below the horizon in the morning"},
		            {"misheyakirMachmir", "Earliest tallis & tefillin", "Misheyakir Machmir", "Sun is 10.2° below the horizon in the morning"},
		            {"plagHaMincha", "Half of Mincha", "Plag HaMincha", "Sunrise plus 10.75 halachic hours"},
		            {"shaahZmanis", "Proportional Hour", "Shaah Zmanis", "Halachic hour, one-twelfth of the period from the beginning of the day (sunrise) until its conclusion (sunset)"},
		            {"sofZmanShma", "Latest Shema (Gra)", "Sof Z’man Kriyas Shema (Gra)", "Sunrise plus 3 halachic hours, according to the Gra"},
		            {"sofZmanShmaMGA", "Latest Shema (MGA Gra-36)", "Sof Z’man Kriyas Shema (MGA Gra-36 min.)", "Sunrise plus 3 halachic hours, according to Magen Avraham"},
		            {"sofZmanShmaMGA16Point1", "Latest Shema (MGA 16.1°)", "Sof Z’man Kriyas Shema (MGA 16.1°)", "Alos HaShachar plus 3 halachic hours, according to Magen Avraham"},
		            {"sofZmanTfilla", "Latest Shacharis (Gra)", "Sof Z’man Tefillah (Gra)", "Sunrise plus 4 halachic hours, according to the Gra"},
		            {"sofZmanTfillaMGA", "Latest Shacharis (MGA)", "Sof Z’man Tefillah (MGA)", "Alos HaShachar plus 4 halachic hours, according to Magen Avraham"},
		            {"sunrise", "Sunrise", "Hanetz HaChama", "Upper edge of the sun appears over the eastern horizon in the morning (0.833° above horizon)"},
		            {"sunset", "Sunset", "Shkiah", "When the upper edge of the sun disappears below the horizon (0.833° below horizon)"},
		            {"tzeit42min", "Nightfall (3 medium stars)", "Tzeis Hakochavim (42 min.)", "When 3 medium stars are observable in the night sky with the naked eye (fixed 42 minutes after sunset)"},
		            {"tzeit50min", "Nightfall (3 small stars)", "Tzeis Hakochavim (50 min.)", "When 3 small stars are observable in the night sky with the naked eye (fixed 50 minutes after sunset)"},
		            {"tzeit7083deg", "Nightfall (3 medium stars)", "Tzeis Hakochavim (7.083°)", "When 3 medium stars are observable in the night sky with the naked eye (sun 7.083° below the horizon)"},
		            {"tzeit72min", "Nightfall (Rabbeinu Tam)", "Tzeis Hakochavim (72 min.)", "When 3 small stars are observable in the night sky with the naked eye (fixed 72 minutes after sunset)"},
		            {"tzeit85deg", "Nightfall (3 small stars)", "Tzeis Hakochavim (8.5°)", "When 3 small stars are observable in the night sky with the naked eye (sun 8.5° below the horizon)"}
		        }
		    )
		in
		    Source
	lineageTag: e1bc547b-6ead-41af-9265-e0256b180b6f
	queryGroup: Zmanim

