expression textBeforeCardinalDelimiters =
		let
		    GetTextBeforeDelimiters = (inputText as text) as text =>
		    let
		        delimiterList = {"th", "nd", "st", "rd"},
		        results = List.Transform(delimiterList, each try Text.BeforeDelimiter(inputText, _) otherwise inputText),
		        firstNonOriginal = List.First(List.Select(results, each _ <> inputText))
		    in
		        if firstNonOriginal = null then inputText else firstNonOriginal
		in
		    GetTextBeforeDelimiters
	lineageTag: f4119fef-1b4a-42ca-8a1e-fa7e851d3569
	queryGroup: Zmanim

